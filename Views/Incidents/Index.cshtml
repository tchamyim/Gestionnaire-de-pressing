@model List<OrderIncident>
@{
    ViewData["Title"] = "Réclamations et incidents";
}
<div class="page-heading"><div><span class="eyebrow">SUPERVISION</span><h1>Réclamations et incidents</h1><p>Traitez les signalements liés aux tickets et gardez une trace de la résolution.</p></div></div>
<section class="panel"><div class="table-scroll"><table><thead><tr><th>Signalé le</th><th>Ticket / client</th><th>Employé</th><th>Type et description</th><th>Suivi responsable</th></tr></thead><tbody>
@foreach (var incident in Model)
{
    <tr>
        <td>@incident.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
        <td><a class="ticket-link" asp-controller="Orders" asp-action="Details" asp-route-id="@incident.OrderId">@incident.TicketNo</a><small class="contact-subline">@incident.ClientName</small></td>
        <td>@incident.ReporterName</td>
        <td><strong>@incident.Category</strong><small class="contact-subline">@incident.Description</small></td>
        <td>
            <form asp-action="Update" method="post" class="incident-update-form">
                <input type="hidden" name="id" value="@incident.IncidentId"/>
                <select name="Status"><option value="nouveau" selected="@(incident.Status == "nouveau" ? "selected" : null)">Nouveau</option><option value="en cours" selected="@(incident.Status == "en cours" ? "selected" : null)">En cours</option><option value="résolu" selected="@(incident.Status == "résolu" ? "selected" : null)">Résolu</option><option value="annulé" selected="@(incident.Status == "annulé" ? "selected" : null)">Annulé</option></select>
                <textarea name="Resolution" rows="2" maxlength="1000" placeholder="Action décidée / résolution">@incident.Resolution</textarea>
                <button class="button button-primary button-small" type="submit">Enregistrer</button>
            </form>
        </td>
    </tr>
}
@if (Model.Count == 0) { <tr><td colspan="5"><div class="empty-inline">Aucun signalement pour le moment.</div></td></tr> }
</tbody></table></div></section>
