@model OrderDetailViewModel
@{
    ViewData["Title"] = Model.Order.TicketNo;
    var statuses = new[] { "déposé", "en traitement", "prêt", "retiré" };
    var lastPaymentId = int.TryParse(Convert.ToString(TempData["LastPaymentId"]), out var parsedPaymentId) ? parsedPaymentId : 0;
    var hasReadyArticle = Model.Items.Any(item => item.ItemStatus == "prêt");
    var whatsAppPhone = string.IsNullOrWhiteSpace(Model.Client.WhatsApp) ? Model.Client.Phone : Model.Client.WhatsApp;
    var canUseWhatsApp = ClientCommunicationLinks.WhatsApp(whatsAppPhone, "Bonjour, Fresh & Care vous contacte au sujet de votre ticket " + Model.Order.TicketNo + ".") is not null;
}
<div class="page-heading">
    <div>
        <span class="eyebrow">TICKET DE DÉPÔT</span>
        <h1 class="ticket-heading">@Model.Order.TicketNo <span class="status-pill">@Model.Order.OrderStatus</span></h1>
        <p>@Model.Client.FirstName @Model.Client.LastName · @Model.Client.Phone · reçu le @Model.Order.CreatedAt.ToString("dd/MM/yyyy à HH:mm")</p>
    </div>
    <div class="heading-actions">
        <a class="button button-outline" asp-controller="Clients" asp-action="Details" asp-route-id="@Model.Client.ClientId">Fiche client</a>
        @if(canUseWhatsApp){<a class="button button-whatsapp" asp-controller="Communications" asp-action="WhatsApp" asp-route-id="@Model.Order.OrderId">WhatsApp</a>}
        @if(hasReadyArticle){<a class="button button-primary" asp-controller="Communications" asp-action="Compose" asp-route-id="@Model.Order.OrderId">✉ Prévenir par e-mail</a>}
        <a class="button button-primary" asp-action="ThermalTicket" asp-route-id="@Model.Order.OrderId" target="_blank">🖨 Ticket 80mm &amp; Étiquettes</a>
        <a class="button button-soft" asp-controller="Receipts" asp-action="InvoicePdf" asp-route-id="@Model.Order.OrderId">↓ Facture PDF</a>
        <a class="button button-soft" asp-controller="Receipts" asp-action="InvoiceExcel" asp-route-id="@Model.Order.OrderId">↓ Excel</a>
        <a class="button button-soft" asp-controller="Receipts" asp-action="InvoiceWord" asp-route-id="@Model.Order.OrderId">↓ Word</a>
        <a class="button button-outline" asp-controller="Receipts" asp-action="Ticket" asp-route-id="@Model.Order.OrderId" target="_blank">↓ Ticket PDF</a>
    </div>
</div>

@if (lastPaymentId > 0)
{
    <section class="panel payment-success-panel">
        <div class="panel-heading"><div><span class="eyebrow">PAIEMENT CONFIRMÉ</span><h2>Vos documents sont prêts</h2></div><span class="stat-icon green">✓</span></div>
        <div class="heading-actions">
            <a class="button button-primary" asp-controller="Receipts" asp-action="InvoicePdf" asp-route-id="@Model.Order.OrderId">Télécharger la facture PDF</a>
            <a class="button button-outline" asp-controller="Receipts" asp-action="InvoiceExcel" asp-route-id="@Model.Order.OrderId">Ouvrir la facture Excel</a>
            <a class="button button-outline" asp-controller="Receipts" asp-action="InvoiceWord" asp-route-id="@Model.Order.OrderId">Ouvrir la facture Word</a>
            <a class="button button-soft" asp-controller="Receipts" asp-action="Payment" asp-route-id="@lastPaymentId">Reçu du paiement PDF</a>
        </div>
        <p class="field-hint">Les factures reprennent les articles, les paiements, le solde et le cachet Fresh &amp; Care.</p>
    </section>
}

<div class="order-summary-grid">
    <article class="summary-box">
        <span>Total du ticket</span>
        <strong>@Fcfa(Model.Order.Total)</strong>
        @if (Model.Order.DiscountAmount > 0)
        {
            <small class="muted">Remise appliquée : -@Fcfa(Model.Order.DiscountAmount)</small>
        }
    </article>
    <article class="summary-box"><span>Déjà réglé</span><strong class="money-paid">@Fcfa(Model.Order.Paid)</strong></article>
    <article class="summary-box summary-due"><span>Reste à payer</span><strong class="money-due">@Fcfa(Model.Order.Remaining)</strong></article>
    <article class="summary-box"><span>Solde espèces en caisse</span><strong>@Fcfa(Model.CashBalance)</strong></article>
</div>

<section class="panel">
    <div class="panel-heading batch-heading">
        <div><span class="eyebrow">SUIVI ATELIER &amp; RANGEMENT</span><h2>Pièces du dépôt <span class="count-pill">@Model.Items.Count</span></h2></div>
        @if (Model.Items.Any(i => i.ItemStatus != "retiré"))
        {
            <form asp-action="UpdateAllStatus" method="post" class="batch-status-form">
                <input type="hidden" name="id" value="@Model.Order.OrderId" />
                <input type="text" name="storageLocation" placeholder="Emplacement (ex. Penderie A-12)" maxlength="60" />
                <button type="submit" name="status" value="en traitement" class="button button-soft button-small">Tout En traitement</button>
                <button type="submit" name="status" value="prêt" class="button button-primary button-small">✓ Tout marquer Prêt</button>
                <button type="submit" name="status" value="retiré" class="button button-outline button-small">Tout Retiré</button>
            </form>
        }
    </div>
    <div class="item-list">
    @foreach (var item in Model.Items)
    {
        var statusClass = item.ItemStatus switch
        {
            "déposé" => "status-deposee",
            "en traitement" => "status-traitement",
            "prêt" => "status-pret",
            "retiré" => "status-retire",
            _ => ""
        };
        <article class="item-card">
            <div class="item-card-main">
                <span class="item-icon">♧</span>
                <div>
                    <strong>
                        @item.CategoryName
                        @if(item.IsExpress){<span class="express-pill">EXPRESS</span>}
                        <span class="status-pill @statusClass">@item.ItemStatus</span>
                        @if(!string.IsNullOrWhiteSpace(item.StorageLocation)){<span class="location-pill">📍 @item.StorageLocation</span>}
                    </strong>
                    <p>@(string.IsNullOrWhiteSpace(item.Description) ? "Aucun repère ajouté" : item.Description)</p>
                    @if (!string.IsNullOrWhiteSpace(item.ConditionNotes))
                    {
                        <p class="condition-warning">⚠ Réserve : @item.ConditionNotes</p>
                    }
                    <small>Dépôt @item.DepositAt.ToString("dd/MM/yyyy HH:mm") · retrait prévu @(item.ExpectedPickupAt?.ToString("dd/MM/yyyy") ?? "à définir")</small>
                </div>
            </div>
            <div class="item-price"><span>@Fcfa(item.UnitPrice + item.ExpressFee)</span>@if(item.ExpressFee > 0){<small>dont express @Fcfa(item.ExpressFee)</small>}</div>
            <form asp-action="UpdateItem" method="post" class="item-status-form">
                <input type="hidden" name="id" value="@Model.Order.OrderId"/>
                <input type="hidden" name="itemId" value="@item.ItemId"/>
                <select name="ItemStatus" aria-label="Statut de l’article">
                    @foreach(var status in statuses){<option selected="@(item.ItemStatus == status ? "selected" : null)" value="@status">@status</option>}
                </select>
                <input type="text" name="StorageLocation" value="@item.StorageLocation" placeholder="Penderie / Casier" maxlength="60" aria-label="Emplacement" />
                <input type="date" name="ExpectedPickupAt" value="@item.ExpectedPickupAt?.ToString("yyyy-MM-dd")" aria-label="Date prévue de retrait"/>
                <button class="button button-soft button-small" type="submit">OK</button>
            </form>
        </article>
    }
    </div>
</section>

<div class="detail-grid payment-grid">
    <section class="panel"><div class="panel-heading"><div><span class="eyebrow">ENCAISSEMENT</span><h2>Enregistrer un paiement</h2></div></div>
        @if (Model.Order.Remaining > 0)
        {
            <form asp-action="Pay" method="post" class="payment-form">
                <input type="hidden" name="id" value="@Model.Order.OrderId"/>
                <div class="field"><label>Montant reçu (FCFA)</label><input type="number" name="Amount" min="1" max="@Model.Order.Remaining" step="1" value="@Model.Order.Remaining" required/></div>
                <div class="field"><label>Moyen de paiement</label><select name="PaymentMethod"><option>Espèces</option><option>MTN Money</option><option>Orange Money</option><option>Virement</option><option>Carte</option></select></div>
                <div class="field"><label>Référence <small>(facultatif)</small></label><input name="Reference" maxlength="100" placeholder="Référence de transaction"/></div>
                <button class="button button-primary button-full" type="submit">Valider le paiement</button>
                <p class="field-hint">Le paiement espèces augmente la caisse. Les autres moyens sont suivis dans l’historique du ticket.</p>
            </form>
        }
        else { <div class="paid-message">✓ Ticket intégralement réglé.</div> }
    </section>
    <section class="panel"><div class="panel-heading"><div><span class="eyebrow">HISTORIQUE</span><h2>Paiements reçus</h2></div></div>
        @if (Model.Payments.Count == 0) { <div class="empty-inline">Aucun paiement enregistré.</div> }
        else { <div class="table-scroll"><table><thead><tr><th>Reçu</th><th>Date</th><th>Moyen</th><th>Montant</th><th></th></tr></thead><tbody>@foreach(var payment in Model.Payments){<tr><td>@payment.ReceiptNo</td><td>@payment.PaymentAt.ToString("dd/MM/yy HH:mm")</td><td>@payment.PaymentMethod</td><td>@Fcfa(payment.Amount)</td><td><a class="text-link" asp-controller="Receipts" asp-action="Payment" asp-route-id="@payment.PaymentId" target="_blank">PDF</a></td></tr>}</tbody></table></div> }
    </section>
</div>
