@model StaffUserInput
@{
    ViewData["Title"] = "Modifier un compte employé";
    var roles = ViewBag.RoleCatalog as IReadOnlyList<Pressings.Services.StaffRoleOption> ?? [];
    var selected = ViewBag.SelectedRoles as HashSet<string> ?? [];
}
<div class="page-heading"><div><span class="eyebrow">ÉQUIPE &amp; ACCÈS</span><h1>Modifier le compte</h1><p>Le champ mot de passe peut rester vide si tu ne veux pas le changer.</p></div><a class="button button-outline" asp-action="Index">← Équipe</a></div>
<div class="form-layout"><section class="panel form-panel"><form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="All" class="validation-summary"></div>
    <div class="form-grid">
        <div class="field"><label asp-for="DisplayName">Nom affiché</label><input asp-for="DisplayName"/><span asp-validation-for="DisplayName"></span></div>
        <div class="field"><label asp-for="Email">Adresse e-mail de connexion</label><input asp-for="Email"/><span asp-validation-for="Email"></span></div>
        <div class="field field-wide"><label asp-for="Password">Nouveau mot de passe <small>(facultatif)</small></label><input asp-for="Password" type="password" autocomplete="new-password" minlength="12"/><span asp-validation-for="Password"></span></div>
    </div>
    <fieldset class="role-picker"><legend>Rôles et accès</legend><p class="field-hint">Tu peux cocher plusieurs fonctions pour un employé polyvalent.</p>
        @foreach (var role in roles)
        {
            <label class="role-option"><input type="checkbox" name="RoleCodes" value="@role.Code" checked="@selected.Contains(role.Code)" /><span><strong>@role.Name</strong><small>@role.Description</small></span></label>
        }
        <span asp-validation-for="RoleCodes"></span>
    </fieldset>
    <div class="field check-row"><label><input asp-for="IsActive" /> Compte actif</label><span asp-validation-for="IsActive"></span></div>
    <div class="form-actions"><a class="button button-outline" asp-action="Index">Annuler</a><button class="button button-primary" type="submit">Enregistrer</button></div>
</form></section></div>
