@model List<StaffUserRow>
@{
    ViewData["Title"] = "Comptes employés";
}
<div class="page-heading">
    <div><span class="eyebrow">ÉQUIPE &amp; ACCÈS</span><h1>Comptes employés</h1><p>Un compte par personne ; plusieurs rôles peuvent être attribués si le poste le demande.</p></div>
    <a class="button button-primary" asp-action="Create">＋ Ajouter un employé</a>
</div>
<section class="panel">
    <div class="table-scroll"><table><thead><tr><th>Employé</th><th>Adresse e-mail</th><th>Rôles</th><th>Compte</th><th>Actions</th></tr></thead><tbody>
    @foreach (var employee in Model)
    {
        <tr>
            <td><strong>@employee.DisplayName</strong></td>
            <td>@employee.Email</td>
            <td>@(string.IsNullOrWhiteSpace(employee.RoleNames) ? "Aucun rôle" : employee.RoleNames)</td>
            <td><span class="status-pill @(employee.IsActive ? "status-pret" : "status-retire")">@(employee.IsActive ? "Actif" : "Désactivé")</span></td>
            <td class="table-actions">
                <a class="button button-soft button-small" asp-action="Edit" asp-route-id="@employee.Id">Modifier</a>
                @if (employee.Id != int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value))
                {
                    <form asp-action="SetActive" method="post" class="inline-form">
                        <input type="hidden" name="id" value="@employee.Id" />
                        <input type="hidden" name="active" value="@(!employee.IsActive)" />
                        <button class="button button-outline button-small" type="submit">@(employee.IsActive ? "Désactiver" : "Réactiver")</button>
                    </form>
                }
            </td>
        </tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="5"><div class="empty-inline">Aucun compte employé.</div></td></tr> }
    </tbody></table></div>
</section>
