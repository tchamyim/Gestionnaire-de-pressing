@{
    ViewData["Title"] = "Bienvenue";
}

<div class="auth-card role-choice landing-card">
    <div class="landing-hero">
        <div class="landing-logo-wrap">
            <img class="landing-logo" src="~/img/fresh-care-logo.png" alt="Fresh &amp; Care Pressing" />
        </div>
        <span class="landing-badge">PRESSING · BLANCHISSERIE · ENTRETIEN TEXTILE</span>
        <h1 class="landing-slogan">Le soin du linge,<br><em>en toute simplicité.</em></h1>
        <p class="landing-sub">Bienvenue chez Fresh &amp; Care — votre partenaire de confiance pour un linge impeccable.</p>
        <section class="landing-naya" data-naya-presentation aria-labelledby="naya-title">
            <div class="landing-naya-mark" aria-hidden="true"><span>N</span><i></i></div>
            <div class="landing-naya-content">
                <div class="landing-naya-heading">
                    <div><span class="landing-naya-kicker">IA NAYA · GUIDE VOCAL</span><strong id="naya-title">Elle présente l’application pour vous.</strong></div>
                    <span class="landing-naya-state" data-naya-state>Prête</span>
                </div>
                <p class="landing-naya-caption" data-naya-caption aria-live="polite">Appuyez une fois pour lancer la visite commentée de Fresh &amp; Care.</p>
                <div class="landing-naya-controls">
                    <button class="button button-primary button-small" type="button" data-naya-start>▶ Démarrer la présentation</button>
                    <button class="button button-outline button-small" type="button" data-naya-stop disabled>Arrêter</button>
                </div>
                <div class="landing-naya-progress" role="progressbar" aria-label="Progression de la présentation" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span data-naya-progress></span></div>
            </div>
        </section>
    </div>

    <div class="role-choice-grid">
        <a class="role-choice-card-v2 role-manager-v2" asp-controller="Account" asp-action="@ViewBag.ManagerAccessAction">
            <span class="role-icon-v2">🔑</span>
            <span>
                <strong>Espace gérant</strong>
                <small>Clients, dépôts, atelier, caisse et factures</small>
            </span>
            <span class="role-arrow-v2">›</span>
        </a>
        <a class="role-choice-card-v2 role-client-v2" asp-controller="Portal" asp-action="Login">
            <span class="role-icon-v2">👔</span>
            <span>
                <strong>Espace client</strong>
                <small>Suivi des tickets, vêtements prêts et messagerie</small>
            </span>
            <span class="role-arrow-v2">›</span>
        </a>
    </div>

    <p class="auth-help">Les deux espaces partagent la même base de données en temps réel.</p>
</div>
<script src="~/js/naya-presentation.js" asp-append-version="true"></script>
