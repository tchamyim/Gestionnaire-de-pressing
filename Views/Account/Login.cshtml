@model AdminLoginInput
@{
    ViewData["Title"] = "Connexion gestionnaire";
}
<div class="auth-card"><div class="auth-emblem">✦</div><span class="eyebrow">ESPACE PROFESSIONNEL</span><h1>Bon retour !</h1><p class="auth-subtitle">Connectez-vous à votre espace de gestion.</p>
<form asp-action="Login" method="post" class="auth-form">
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
    <div class="field"><label asp-for="Email">Adresse e-mail</label><input asp-for="Email" autocomplete="username" placeholder="Adresse e-mail"/></div>
    <div class="field"><label asp-for="Password">Mot de passe</label><input asp-for="Password" type="password" autocomplete="current-password" placeholder="Mot de passe"/></div>
    <button class="button button-primary button-full" type="submit">Se connecter <span>→</span></button>
</form><div class="auth-divider"><span>OU</span></div><a class="portal-login-link" asp-controller="Portal" asp-action="Login">Accéder à mon espace client <span>→</span></a></div>
