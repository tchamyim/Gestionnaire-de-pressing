@model List<ActivityLogRow>
@{
    ViewData["Title"] = "Journal d’activité";
}
<div class="page-heading"><div><span class="eyebrow">TRAÇABILITÉ</span><h1>Journal d’activité</h1><p>Les opérations récentes, leur auteur et leur date sont consultables ici.</p></div></div>
<section class="panel"><div class="table-scroll"><table><thead><tr><th>Date</th><th>Employé</th><th>Action</th><th>Détail</th></tr></thead><tbody>
@foreach (var item in Model)
{
    <tr><td>@item.EventAt.ToString("dd/MM/yyyy HH:mm")</td><td>@item.EmployeeName</td><td><strong>@item.EventType</strong></td><td>@item.Details</td></tr>
}
@if (Model.Count == 0) { <tr><td colspan="4"><div class="empty-inline">Aucune activité enregistrée.</div></td></tr> }
</tbody></table></div></section>
