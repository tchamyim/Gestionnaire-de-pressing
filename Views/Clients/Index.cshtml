@model List<ClientRecord>
@{
    ViewData["Title"] = "Clients";
}
<div class="page-heading"><div><span class="eyebrow">RELATION CLIENT</span><h1>Clients</h1><p>Retrouvez les fiches, les soldes et l’historique de chaque client.</p></div><a class="button button-primary" asp-action="Create">＋ Nouveau client</a></div>
<section class="panel">
    <form class="search-bar" method="get"><span>⌕</span><input name="q" value="@ViewBag.Query" placeholder="Nom, téléphone ou WhatsApp…"/><button class="button button-outline button-small" type="submit">Rechercher</button></form>
    <div class="table-scroll"><table><thead><tr><th>Client</th><th>Téléphone</th><th>WhatsApp</th><th>Inscrit le</th><th>Solde dû</th><th></th></tr></thead><tbody>
    @foreach (var client in Model)
    {
        <tr><td><div class="client-cell"><span class="client-avatar">@client.FirstName.Substring(0,1).ToUpperInvariant()</span><span><strong>@client.FirstName @client.LastName</strong><small>@client.Email</small></span></div></td><td>@client.Phone</td><td>@(string.IsNullOrWhiteSpace(client.WhatsApp) ? "—" : client.WhatsApp)</td><td>@client.CreatedAt.ToString("dd/MM/yyyy")</td><td><span class="@(client.Balance > 0 ? "money-due" : "money-paid")">@Fcfa(client.Balance)</span></td><td><a class="button button-soft button-small" asp-action="Details" asp-route-id="@client.ClientId">Ouvrir</a></td></tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="6"><div class="empty-inline">Aucun client trouvé.</div></td></tr> }
    </tbody></table></div>
</section>
