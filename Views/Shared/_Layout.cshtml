<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "Gestion Pressing") · Fresh &amp; Care</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/enhancements.css" asp-append-version="true" />
</head>
@{
    var activeController = ViewContext.RouteData.Values["controller"]?.ToString();
    var activeAction = ViewContext.RouteData.Values["action"]?.ToString();
}
<body class="@(User.Identity?.IsAuthenticated == true ? "app-page" : "auth-page")">
    @if (User.IsInRole("staff"))
    {
        <div class="app-shell">
            <aside class="sidebar">
                <a class="brand" asp-controller="Dashboard" asp-action="Index"><img class="brand-logo" src="~/img/fresh-care-logo.png" alt="Fresh &amp; Care"/><span><strong>FRESH <b>&amp;</b> CARE</strong><small>GESTION PRESSING</small></span></a>
                <div class="nav-caption">ESPACE GESTION</div>
                <nav class="main-nav">
                    <a class="@(activeController == "Dashboard" && activeAction == "Index" ? "nav-current" : null)" aria-current="@(activeController == "Dashboard" && activeAction == "Index" ? "page" : null)" asp-controller="Dashboard" asp-action="Index">🏠 <span>Dashboard</span></a>
                    <a class="@(activeController == "Clients" ? "nav-current" : null)" aria-current="@(activeController == "Clients" ? "page" : null)" asp-controller="Clients" asp-action="Index">👥 <span>Clients</span></a>
                    <a class="@(activeController == "Orders" ? "nav-current" : null)" aria-current="@(activeController == "Orders" ? "page" : null)" asp-controller="Orders" asp-action="Index">📋 <span>Tickets &amp; articles</span></a>
                    <a class="@(activeController == "Communications" ? "nav-current" : null)" aria-current="@(activeController == "Communications" ? "page" : null)" asp-controller="Communications" asp-action="Index">✉️ <span>Messagerie</span>@if (ViewBag.UnreadMessages != null && (int)ViewBag.UnreadMessages > 0){<b class="topbar-badge">@ViewBag.UnreadMessages</b>}</a>
                    <a class="@(activeController == "Inventory" ? "nav-current" : null)" aria-current="@(activeController == "Inventory" ? "page" : null)" asp-controller="Inventory" asp-action="Index">📦 <span>Stock &amp; consommables</span></a>
                    <a class="@(activeController == "Tariffs" ? "nav-current" : null)" aria-current="@(activeController == "Tariffs" ? "page" : null)" asp-controller="Tariffs" asp-action="Index">💲 <span>Grille tarifaire</span></a>
                    <a class="@(activeController == "Dashboard" && activeAction == "ClosingReport" ? "nav-current" : null)" aria-current="@(activeController == "Dashboard" && activeAction == "ClosingReport" ? "page" : null)" asp-controller="Dashboard" asp-action="ClosingReport">📊 <span>Rapports</span></a>
                </nav>
                <div class="sidebar-bottom">
                    <div class="user-chip"><span class="user-avatar">@User.Identity?.Name?.Substring(0, 1).ToUpperInvariant()</span><span><strong>Gestionnaire</strong><small>@User.Identity?.Name</small></span></div>
                    <form asp-controller="Account" asp-action="Logout" method="post"><button class="nav-logout" type="submit">↪ Déconnexion</button></form>
                </div>
            </aside>
            <main class="main-content">
                <header class="topbar"><div><span class="eyebrow">ESPACE PROFESSIONNEL</span><strong>Bienvenue chez Fresh &amp; Care</strong></div><a class="button button-primary button-small" asp-controller="Orders" asp-action="Create">＋ Nouveau dépôt</a></header>
                <div class="content-wrap">
                    @await Html.PartialAsync("_Flash")
                    @RenderBody()
                    <footer class="app-signature">
                        <span class="signature-mark" aria-hidden="true">F<span>&amp;</span>C</span>
                        <span><strong>Le soin du linge, avec rigueur.</strong><small>Un suivi clair, de l’accueil au retrait · Yaoundé</small></span>
                    </footer>
                </div>
            </main>
        </div>
        <aside class="naya-page-guide" data-naya-guide
               data-controller="@activeController"
               data-action="@activeAction"
               data-auto-open="@((activeController == "Clients" && (activeAction == "Create" || activeAction == "Edit")) || (activeController == "Orders" && (activeAction == "Create" || activeAction == "Details")) || (activeController == "Communications" && (activeAction == "Compose" || activeAction == "Thread")) || (activeController == "Inventory" && activeAction == "Index") || (activeController == "Tariffs" && activeAction == "Index") || (activeController == "Dashboard" && activeAction == "ClosingReport") ? "true" : "false")">
            <section class="naya-page-guide-panel" data-naya-guide-panel hidden>
                <header><span data-naya-guide-heading>Naya · guide de la page</span><button type="button" data-naya-guide-close aria-label="Fermer le guide Naya">×</button></header>
                <strong data-naya-guide-title>Comprendre cette étape</strong>
                <p data-naya-guide-text aria-live="polite"></p>
                <div class="naya-page-guide-actions">
                    <button class="button button-primary button-small" type="button" data-naya-guide-speak>🔊 Écouter les conseils</button>
                    <button class="button button-outline button-small" type="button" data-naya-guide-stop disabled>Arrêter</button>
                </div>
                <small class="naya-page-guide-status" data-naya-guide-status aria-live="polite"></small>
            </section>
            <button class="naya-page-guide-toggle" type="button" data-naya-guide-toggle aria-expanded="false">
                <span class="naya-guide-avatar" aria-hidden="true">N</span><span><strong>Naya</strong><small data-naya-guide-toggle-text>Besoin d’aide ?</small></span><span class="naya-guide-chevron" aria-hidden="true">⌃</span>
            </button>
        </aside>
        <script src="~/js/naya-guide.js" asp-append-version="true"></script>
    }
    else if (User.IsInRole("client"))
    {
        <div class="portal-shell">
            <header class="portal-header"><a class="brand brand-dark" asp-controller="Portal" asp-action="Index"><img class="brand-logo" src="~/img/fresh-care-logo.png" alt="Fresh &amp; Care"/><span><strong>FRESH <b>&amp;</b> CARE</strong><small>VOTRE ESPACE CLIENT</small></span></a><div class="portal-head-actions"><a class="button button-soft button-small" asp-controller="Portal" asp-action="Conversation">✉ Écrire au pressing</a><span>Bonjour, @User.Identity?.Name</span><form asp-controller="Portal" asp-action="Logout" method="post"><button class="button button-outline button-small" type="submit">Déconnexion</button></form></div></header>
            <main class="portal-content">@await Html.PartialAsync("_Flash") @RenderBody()</main>
        </div>
        <script src="~/js/voice-assistant.js" asp-append-version="true"></script>
    }
    else
    {
        <main class="auth-layout">
            <section class="auth-hero"><div class="auth-hero-shade"></div><a class="brand brand-light" asp-controller="Home" asp-action="Index"><img class="brand-logo" src="~/img/fresh-care-logo.png" alt="Fresh &amp; Care"/><span><strong>FRESH <b>&amp;</b> CARE</strong><small>PRESSING · BLANCHISSERIE · ENTRETIEN TEXTILE</small></span></a><div class="hero-message"><span class="hero-kicker">LE SOIN DU LINGE</span><h1>En toute <em>simplicité.</em></h1><p>Un suivi clair, un linge impeccable et un service pensé pour vous.</p><div class="hero-pills"><span>✦ Service soigné</span><span>◷ Suivi en temps réel</span></div></div></section>
            <section class="auth-panel">@await Html.PartialAsync("_Flash") @RenderBody()<footer>© @DateTime.Now.Year Fresh &amp; Care · Yaoundé</footer></section>
        </main>
    }
</body>
</html>
